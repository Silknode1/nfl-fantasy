{
  "name": "nfl-fantasy-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:artifact": "tsc -b && vite build --mode artifact",
    "preview": "vite preview",
    "test": "vitest run",
    "preview:artifact": "python3 scripts/inline_photos.py public/data/fantasy.json src/inline-data.json && npm run build:artifact && python3 scripts/to_fragment.py dist-artifact/index.html dist-artifact/page.html",
    "check": "tsx scripts/check.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.1.4"
  }
}